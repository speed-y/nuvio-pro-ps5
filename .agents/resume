#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
# No authentication, console access, services or dependency installs are needed.
source "$repo_root/.cache/orb-tools/env"
python3 - <<'PY'
import json
import platform
import subprocess

versions = {p['id']: p.get('version') for p in json.load(open('deps.lock'))['host_requirements']}
assert platform.python_version() == versions['python'], 'Run .agents/setup to refresh Python'
assert subprocess.check_output(['node', '--version'], text=True).strip() == 'v' + versions['node'], 'Run .agents/setup to refresh Node'
print('Orb toolchains ready. Native PS5 builds require macOS.')
PY
