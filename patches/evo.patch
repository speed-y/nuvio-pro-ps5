+    query_param(path, "next", value, sizeof value);
+    memset(&s_h_next, 0, sizeof s_h_next);
+    if (sscanf(value, "%d,%d,%c,%lf%n", &automatic, &seconds, &mode, &threshold, &end) != 4 ||
+        value[end] || automatic < 0 || automatic > 2 || (seconds != 0 && seconds != 3) ||
+        !isfinite(threshold) || (mode != 'p' && mode != 's') ||
+        (mode == 'p' && (threshold < 0.97 || threshold > 1.0)) ||
+        (mode == 's' && (threshold < 0.0 || threshold > 210.0))) return;
+    s_h_next = (nuvio_next_policy){1, automatic, seconds, mode == 's', threshold};
+}
+
+static void playback_next_begin(void)
+{
+    s_next = s_play_next;
+    s_next_cancelled = s_next_launch = s_next_was_running = 0;
+    s_still_started = 0;
+    s_next_elapsed = s_next_last = 0;
+}
+
+/* 0 hidden, -1 manual, 1..3 countdown, -2 transition, -3 exit to details,
+ * 1001..1060 Still Watching countdown (always wall time while paused).
+ * Actions: 0 update, 1 play now, 2 keep watching. Only playback owns this state. */
+int evo_webui_next_episode(double position, double duration, uint64_t now,
+                          int running, int visible, int action)
+{
+    int was_running = s_next_was_running;
+    uint64_t previous = s_next_last;
+    s_next_last = now;
+    s_next_was_running = 0;
+    if (!s_next.enabled || s_next_cancelled || !visible ||
+        !isfinite(position) || position < 0.0 || !isfinite(duration) || duration <= 120.999) return 0;
+    if (s_next_launch) return -2;
+    double remaining = s_next.minutes ? s_next.threshold : (1.0 - s_next.threshold) * duration;
+    double start = duration - remaining, first = duration, last = 0.0;
+    for (int i = 0; i < 4; ++i) {
+        if (s_skip[i].type != 2 || s_skip[i].end > duration) continue;
+        if (s_skip[i].start < first) first = s_skip[i].start;
+        if (s_skip[i].end > last) last = s_skip[i].end;
+    }
+    /* Match Nuvio's threshold rule without cutting a known post-outro gap. */
+    if (last > 0.0 && duration - last <= remaining) start = first;
+    if (position < start) {
+        s_next_elapsed = 0;
+        return 0;
+    }
+    if (s_next.automatic == 2) {
+        if (!s_still_started) { s_still_start = now; s_still_started = 1; }
+        uint64_t elapsed = now >= s_still_start ? now - s_still_start : 0;
+        if (action == 2 || elapsed >= 60000) {
+            s_next_cancelled = 1;
+            pthread_mutex_lock(&s_mx);
+            s_progress_return_detail = 1;
+            s_progress_next_episode = 0;
+            pthread_mutex_unlock(&s_mx);
+            return -3;
+        }
+        if (action != 1) return 1000 + (int)((60000 - elapsed + 999) / 1000);
+    }
+    if (action == 2) {
+        s_next_cancelled = 1;
+        return 0;
+    }
+    s_next_was_running = running;
+    if (was_running && now >= previous) s_next_elapsed += now - previous;
+    if (action == 1 || (s_next.automatic && running &&
+        s_next_elapsed >= (uint64_t)s_next.seconds * 1000)) {
+        s_next_launch = 1;
+        pthread_mutex_lock(&s_mx);
+        s_progress_next_episode = action == 1 ? 1 : 2;
+        pthread_mutex_unlock(&s_mx);
+        return -2;
+    }
+    if (!s_next.automatic) return -1;
+    if (s_next_elapsed >= (uint64_t)s_next.seconds * 1000) return s_next.seconds ? 1 : -1;
+    return (int)(((uint64_t)s_next.seconds * 1000 - s_next_elapsed + 999) / 1000);
+}
+
+/* Included in evo_webui.c after progress/skip/next policy definitions. */
+#include "nuvio_presentation.h"
+#include "cJSON.h"
+#include <time.h>
+
+static nuvio_presentation_t s_pending_presentation, s_h_presentation, s_play_presentation, s_presentation;
+static char s_presentation_session[64];
+static uint64_t s_presentation_last, s_presentation_running_ms, s_presentation_paused_ms;
+static int s_presentation_running, s_presentation_paused, s_recommendation_index, s_recommendation_dismissed;
+
+static int presentation_bool(const cJSON *root, const char *key)
+{
+    return cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(root, key));
+}
+
+static double presentation_number(const cJSON *root, const char *key, double fallback, double low, double high)
+{
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, key);
+    return cJSON_IsNumber(value) && isfinite(value->valuedouble) &&
+        value->valuedouble >= low && value->valuedouble <= high ? value->valuedouble : fallback;
+}
+
+static void presentation_text(const cJSON *root, const char *key, char *out, size_t cap)
+{
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, key);
+    if (!cJSON_IsString(value) || !value->valuestring) return;
+    const char *text = value->valuestring;
+    size_t len = strlen(text);
+    if (len >= cap) {
+        len = cap - 1;
+        while (len && ((unsigned char)text[len] & 0xc0) == 0x80) --len;
+    }
+    memcpy(out, text, len);
+    out[len] = 0;
+}
+
+static int presentation_decode(const char *body, size_t size)
+{
+    cJSON *root = cJSON_ParseWithLength(body, size + 1);
+    if (!cJSON_IsObject(root)) { cJSON_Delete(root); return 0; }
+    char session[64] = "";
+    presentation_text(root, "session", session, sizeof session);
+    const cJSON *raw_session = cJSON_GetObjectItemCaseSensitive(root, "session");
+    if (!session[0] || !cJSON_IsString(raw_session) || strlen(raw_session->valuestring) >= sizeof session ||
+        strspn(session, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-") != strlen(session)) {
+        cJSON_Delete(root);
+        return 0;
+    }
+    nuvio_presentation_t p = {0};
+    p.active = 1;
+    p.loading = presentation_bool(root, "loading");
+    p.loading_detail = presentation_bool(root, "loadingDetail");
+    p.pause = presentation_bool(root, "pause");
+    p.clock = presentation_bool(root, "clock");
+    p.utc_offset_minutes = (int)presentation_number(root, "utcOffsetMinutes", 0, -840, 840);
+    p.pause_delay_ms = (int)presentation_number(root, "pauseDelayMs", 3000, 0, 60000);
+    p.movie = presentation_bool(root, "movie");
+    p.recommendation_enabled = presentation_bool(root, "recommendationEnabled");
+    p.threshold_minutes = !p.movie && presentation_bool(root, "thresholdMinutes");
+    p.threshold = presentation_number(root, "threshold", p.threshold_minutes ? 120 : p.movie ? 0.9 : 0.99,
+        p.threshold_minutes ? 0 : p.movie ? 0.8 : 0.97, p.threshold_minutes ? 210 : 1);
+    p.episode_threshold_minutes = presentation_bool(root, "episodeThresholdMinutes");
+    p.episode_threshold = presentation_number(root, "episodeThreshold", p.episode_threshold_minutes ? 120 : 0.99,
+        p.episode_threshold_minutes ? 0 : 0.97, p.episode_threshold_minutes ? 210 : 1);
+    p.credits_start = presentation_number(root, "creditsStart", 0, 0, 864000);
+    p.credits_end = presentation_number(root, "creditsEnd", 0, 0, 864000);
+    p.post_credits_end = presentation_number(root, "postCreditsEnd", 0, 0, 864000);
+    presentation_text(root, "description", p.description, sizeof p.description);
+    presentation_text(root, "parental", p.parental, sizeof p.parental);
+    const cJSON *recommendations = cJSON_GetObjectItemCaseSensitive(root, "recommendations");
+    if (cJSON_IsArray(recommendations) && p.recommendation_enabled) {
+        int count = cJSON_GetArraySize(recommendations);
+        if (count > 3) count = 3;
+        for (int i = 0; i < count; ++i) {
+            const cJSON *item = cJSON_GetArrayItem(recommendations, i);
+            presentation_text(item, "title", p.recommendations[i].title, sizeof p.recommendations[i].title);
+            presentation_text(item, "description", p.recommendations[i].description, sizeof p.recommendations[i].description);
+            if (!p.recommendations[i].title[0]) break;
+            ++p.recommendation_count;
+        }
+    }
+    cJSON_Delete(root);
+    pthread_mutex_lock(&s_mx);
+    s_pending_presentation = p;
+    snprintf(s_presentation_session, sizeof s_presentation_session, "%s", session);
+    pthread_mutex_unlock(&s_mx);
+    return 1;
+}
+
+static void serve_presentation(int fd, const char *method, char *req, size_t got, size_t hl)
+{
+    if (strcmp(method, "POST")) { respond(fd, "405 Method Not Allowed", "text/plain", "", 0); return; }
+    char length[32];
+    long size = header_value(req, hl, "Content-Length", length, sizeof length) ? parse_long(length) : -1;
+    if (size < 2 || size > 8192) { respond(fd, "413 Payload Too Large", "text/plain", "", 0); return; }
+    char body[8193];
+    size_t have = got - hl;
+    if (have > (size_t)size) have = (size_t)size;
+    memcpy(body, req + hl, have);
+    while (have < (size_t)size) {
+        ssize_t n = recv(fd, body + have, (size_t)size - have, 0);
+        if (n <= 0) break;
+        have += (size_t)n;
+    }
+    body[have] = 0;
+    int ok = have == (size_t)size && presentation_decode(body, have);
+    respond(fd, ok ? "204 No Content" : "400 Bad Request", "text/plain", "", 0);
+}
+
+static void presentation_handoff(const char *session)
+{
+    memset(&s_h_presentation, 0, sizeof s_h_presentation);
+    if (session[0] && !strcmp(session, s_presentation_session)) s_h_presentation = s_pending_presentation;
+    s_presentation_session[0] = 0;
+    memset(&s_pending_presentation, 0, sizeof s_pending_presentation);
+}
+
+static void presentation_begin(void)
+{
+    s_presentation = s_play_presentation;
+    s_presentation_last = s_presentation_running_ms = s_presentation_paused_ms = 0;
+    s_presentation_running = s_presentation_paused = s_recommendation_dismissed = 0;
+    s_recommendation_index = 1;
+}
+
+const nuvio_presentation_t *evo_webui_presentation(void) { return &s_presentation; }
+
+void evo_webui_presentation_started(void)
+{
+    pthread_mutex_lock(&s_mx);
+    if (s_progress_session[0] && !s_progress_finished) s_progress_played = 1;
+    pthread_mutex_unlock(&s_mx);
+}
+
+void evo_webui_recommendation_selected(int index)
+{
+    if (index < 1 || index > s_presentation.recommendation_count) return;
+    pthread_mutex_lock(&s_mx);
+    s_progress_recommendation = index;
+    s_progress_next_episode = s_progress_return_detail = 0;
+    pthread_mutex_unlock(&s_mx);
+}
+
+/* Matches the browser's known-scene rule. Never show recommendations over a
+ * known post-credit scene just because a percentage threshold was reached. */
+static double presentation_recommendation_start(double duration)
+{
+    const nuvio_presentation_t *p = &s_presentation;
+    double remaining = p->threshold_minutes ? p->threshold : (1.0 - p->threshold) * duration;
+    double start = duration - remaining;
+    if (p->movie) {
+        if (p->post_credits_end > 0 && p->post_credits_end <= duration + 1)
+            return fmin(duration, p->post_credits_end);
+        if (p->credits_end > p->credits_start && p->credits_end <= duration + 1) {
+            double user_remaining = p->episode_threshold_minutes ? p->episode_threshold :
+                (1.0 - p->episode_threshold) * duration;
+            return duration - p->credits_end > user_remaining
+                ? fmax(p->credits_end, duration - user_remaining) : p->credits_start;
+        }
+    } else {
+        double first = duration, last = 0;
+        for (int i = 0; i < 4; ++i) {
+            if (s_skip[i].type != 2 || s_skip[i].end > duration) continue;
+            first = fmin(first, s_skip[i].start);
+            last = fmax(last, s_skip[i].end);
+        }
+        if (last > 0 && duration - last <= remaining) start = first;
+    }
+    return start;
+}
+
+nuvio_presentation_view_t evo_webui_presentation_update(double position, double duration,
+    uint64_t now, int ready, int paused, int blocked, int ended)
+{
+    nuvio_presentation_view_t view = {0};
+    uint64_t delta = now >= s_presentation_last ? now - s_presentation_last : 0;
+    if (s_presentation_running && ready && !paused) s_presentation_running_ms += delta;
+    if (s_presentation_paused && paused && ready) s_presentation_paused_ms += delta;
+    else s_presentation_paused_ms = 0;
+    s_presentation_last = now;
+    s_presentation_running = ready && !paused;
+    s_presentation_paused = ready && paused;
+    const nuvio_presentation_t *p = &s_presentation;
+    if (!p->active || !ready) return view;
+    evo_webui_presentation_started();
+    if (blocked) return view;
+    view.parental = p->parental[0] && !paused && s_presentation_running_ms < 8000;
+    view.pause = p->pause && paused && !ended && s_presentation_paused_ms >= (uint64_t)p->pause_delay_ms;
+    view.recommendation = p->recommendation_enabled && p->recommendation_count &&
+        !s_recommendation_dismissed && !paused && !view.parental && isfinite(position) && position >= 0 &&
+        isfinite(duration) && duration > 120.999 && position >= presentation_recommendation_start(duration)
+        ? s_recommendation_index : 0;
+    return view;
+}
+
+void evo_webui_presentation_action(int action)
+{
+    if (action == 1 && s_presentation.recommendation_count)
+        s_recommendation_index = s_recommendation_index % s_presentation.recommendation_count + 1;
+    if (action == 2) s_recommendation_dismissed = 1;
+}
+
+void evo_webui_presentation_clock(double position, double duration, char *out, size_t size)
+{
+    out[0] = 0;
+    if (!s_presentation.active || !s_presentation.clock) return;
+    time_t now = time(NULL) + s_presentation.utc_offset_minutes * 60;
+    struct tm clock;
+    char current[16], end[16];
+    if (!gmtime_r(&now, &clock) || !strftime(current, sizeof current, "%H:%M", &clock)) return;
+    if (!isfinite(position) || !isfinite(duration) || duration <= position || position < 0) {
+        snprintf(out, size, "%s", current);
+        return;
+    }
+    now += (time_t)(duration - position);
+    if (!gmtime_r(&now, &clock) || !strftime(end, sizeof end, "%H:%M", &clock)) return;
+    snprintf(out, size, "%s   Ends %s", current, end);
+}
+
+/* Included in evo_webui.c. Explicit, single-connection TorBox download test.
+ * No stream headers, account data, persistent files or browser-side transfers. */
+#include "cJSON.h"
+#include <libavformat/avio.h>
+#include <libavutil/dict.h>
+#include <libavutil/error.h>
+#include <libavutil/time.h>
+
+#define SPEEDTEST_BYTES (100 * 1024 * 1024)
+#define SPEEDTEST_DOWNLOAD_US 15000000
+#define SPEEDTEST_TOTAL_US 25000000
+
+static pthread_mutex_t s_speedtest_mx = PTHREAD_MUTEX_INITIALIZER;
+static int s_speedtest_active, s_speedtest_cancel, s_speedtest_blocked = 1;
+static const char *s_speedtest_state = "idle", *s_speedtest_error = "";
+static char s_speedtest_region[16];
+static int64_t s_speedtest_bytes, s_speedtest_started, s_speedtest_elapsed;
+
+/* Only this worker touches its deadline. Cancellation crosses threads under
+ * the mutex. FFmpeg polls during connect/read; synchronous DNS can take longer. */
+static int speedtest_interrupt(void *opaque)
+{
+    pthread_mutex_lock(&s_speedtest_mx);
+    int cancel = s_speedtest_cancel;
+    pthread_mutex_unlock(&s_speedtest_mx);
+    return cancel || av_gettime_relative() >= *(int64_t *)opaque;
+}
+
+static int speedtest_open(AVIOContext **io, const char *url, int64_t *deadline)
+{
+    AVDictionary *options = NULL;
+    /* Do not use evo_stream_io_apply_network_options: it adds private headers.
+     * These are declared options in the pinned FFmpeg HTTP/TCP protocols. */
+    av_dict_set(&options, "protocol_whitelist", "https,tls,tcp", 0);
+    av_dict_set(&options, "rw_timeout", "5000000", 0);
+    av_dict_set(&options, "timeout", "5000000", 0);
+    av_dict_set(&options, "seekable", "0", 0);
+    av_dict_set(&options, "reconnect", "0", 0);
+    av_dict_set(&options, "reconnect_at_eof", "0", 0);
+    av_dict_set(&options, "user_agent", "Nuvio-Pro-speedtest", 0);
+    AVIOInterruptCB interrupt = {speedtest_interrupt, deadline};
+    int rc = avio_open2(io, url, AVIO_FLAG_READ, &interrupt, &options);
+    av_dict_free(&options);
+    return rc;
+}
+
+/* Accept only the public short-test file on TorBox CDN hostnames. Neither the
+ * browser nor an addon can supply a URL. Reject credentials, ports and queries. */
+static int speedtest_url(const char *url)
+{
+    if (strncmp(url, "https://", 8)) return 0;
+    const char *host = url + 8, *path = strchr(host, '/');
+    if (!path || strcmp(path, "/dld/100MB.bin")) return 0;
+    size_t size = (size_t)(path - host);
+    if (!size || size > 127 || strspn(host, "abcdefghijklmnopqrstuvwxyz0123456789-.") != size) return 0;
+    static const char *suffixes[] = {".tb-cdn.io", ".tb-cdn.st", ".tb-cdn.cx",
+        ".tb-cdn.earth", ".tb-cdn.pw", ".tb-cdn.to"};
+    for (size_t i = 0; i < sizeof suffixes / sizeof *suffixes; ++i) {
+        size_t len = strlen(suffixes[i]);
+        if (size > len && !memcmp(path - len, suffixes[i], len)) return 1;
+    }
+    return 0;
+}
+
+static int speedtest_discover(char *url, size_t cap, int64_t *deadline)
+{
+    AVIOContext *io = NULL;
+    if (speedtest_open(&io, "https://api.torbox.app/v1/api/speedtest?test_length=short", deadline) < 0) {
+        avio_closep(&io);
+        return 0;
+    }
+    char body[16385];
+    int used = 0, rc = 0;
+    while (used < (int)sizeof body - 1 && !speedtest_interrupt(deadline)) {
+        rc = avio_read(io, (unsigned char *)body + used, (int)sizeof body - 1 - used);
+        if (rc <= 0) break;
+        used += rc;
+    }
+    avio_closep(&io);
+    if (rc != AVERROR_EOF || used == (int)sizeof body - 1 || speedtest_interrupt(deadline)) return 0;
+    body[used] = 0;
+    cJSON *root = cJSON_ParseWithLength(body, (size_t)used + 1);
+    int found = 0;
+    if (cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(root, "success"))) {
+        const cJSON *item;
+        cJSON_ArrayForEach(item, cJSON_GetObjectItemCaseSensitive(root, "data")) {
+            if (!cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(item, "closest"))) continue;
+            const cJSON *link = cJSON_GetObjectItemCaseSensitive(item, "url");
+            const cJSON *region = cJSON_GetObjectItemCaseSensitive(item, "region");
+            if (cJSON_IsString(link) && strlen(link->valuestring) < cap && speedtest_url(link->valuestring) &&
+                cJSON_IsString(region) && region->valuestring[0] && strlen(region->valuestring) < sizeof s_speedtest_region &&
+                strspn(region->valuestring, "abcdefghijklmnopqrstuvwxyz0123456789-") == strlen(region->valuestring)) {
+                snprintf(url, cap, "%s", link->valuestring);
+                pthread_mutex_lock(&s_speedtest_mx);
+                snprintf(s_speedtest_region, sizeof s_speedtest_region, "%s", region->valuestring);
+                pthread_mutex_unlock(&s_speedtest_mx);
+                found = 1;
+            }
+            break;
+        }
+    }
+    cJSON_Delete(root);
+    return found;
+}
+
+static void *speedtest_worker(void *unused)
+{
+    (void)unused;
+    int64_t deadline = av_gettime_relative() + SPEEDTEST_TOTAL_US;
+    char url[256];
+    const char *error = "Could not find a TorBox test server.";
+    AVIOContext *io = NULL;
+    if (speedtest_discover(url, sizeof url, &deadline) && !speedtest_interrupt(&deadline)) {
+        int64_t start = av_gettime_relative();
+        int64_t download_deadline = start + SPEEDTEST_DOWNLOAD_US;
+        if (download_deadline < deadline) deadline = download_deadline;
+        pthread_mutex_lock(&s_speedtest_mx);
+        s_speedtest_started = start;
+        s_speedtest_state = "downloading";
+        pthread_mutex_unlock(&s_speedtest_mx);
+        error = "Could not download the TorBox test file.";
+        if (speedtest_open(&io, url, &deadline) >= 0 && avio_size(io) == SPEEDTEST_BYTES) {
+            unsigned char buffer[64 * 1024];
+            int64_t bytes = 0;
+            error = "The TorBox download stopped before the test finished.";
+            while (bytes < SPEEDTEST_BYTES && !speedtest_interrupt(&deadline)) {
+                int size = SPEEDTEST_BYTES - bytes < (int64_t)sizeof buffer ?
+                    (int)(SPEEDTEST_BYTES - bytes) : (int)sizeof buffer;
+                int rc = avio_read(io, buffer, size);
+                if (rc <= 0) break;
+                bytes += rc;
+                pthread_mutex_lock(&s_speedtest_mx);
+                s_speedtest_bytes = bytes;
+                pthread_mutex_unlock(&s_speedtest_mx);
+            }
+            /* A timed sample is valid, but an early EOF or network error is
+             * not. Never turn a failed partial transfer into a success. */
+            if (bytes && (bytes == SPEEDTEST_BYTES || av_gettime_relative() >= deadline)) error = "";
+        }
+    }
+    avio_closep(&io);
+    pthread_mutex_lock(&s_speedtest_mx);
+    s_speedtest_elapsed = s_speedtest_started ? av_gettime_relative() - s_speedtest_started : 0;
+    s_speedtest_state = s_speedtest_cancel ? "cancelled" : error[0] ? "error" : "completed";
+    s_speedtest_error = s_speedtest_cancel ? "" : error;
+    s_speedtest_active = 0;
+    pthread_mutex_unlock(&s_speedtest_mx);
+    return NULL;
+}
+
+static void speedtest_suspend(void)
+{
+    pthread_mutex_lock(&s_speedtest_mx);
+    s_speedtest_blocked = 1;
+    s_speedtest_cancel = 1;
+    pthread_mutex_unlock(&s_speedtest_mx);
+}
+
+static void speedtest_resume(void)
+{
+    pthread_mutex_lock(&s_speedtest_mx);
+    s_speedtest_blocked = 0;
+    pthread_mutex_unlock(&s_speedtest_mx);
+}
+
+/* Main-thread handoff waits without blocking a frame or freeing worker state. */
+static int speedtest_quiet(void)
+{
+    speedtest_suspend();
+    pthread_mutex_lock(&s_speedtest_mx);
+    int quiet = !s_speedtest_active;
+    pthread_mutex_unlock(&s_speedtest_mx);
+    return quiet;
+}
+
+static void serve_speedtest(int fd, const char *method, const char *path)
+{
+    int start = !strcmp(path, "/evo/speedtest/start");
+    int cancel = !strcmp(path, "/evo/speedtest/cancel");
+    const char *status = "200 OK", *request_error = NULL;
+    if (!start && !cancel && strcmp(path, "/evo/speedtest/status")) {
+        respond(fd, "404 Not Found", "application/json", "{}", 2);
+        return;
+    }
+    if (strcmp(method, start || cancel ? "POST" : "GET")) {
+        respond(fd, "405 Method Not Allowed", "application/json", "{}", 2);
+        return;
+    }
+    pthread_mutex_lock(&s_speedtest_mx);
+    if (cancel) s_speedtest_cancel = 1;
+    if (start && (s_speedtest_active || s_speedtest_blocked)) {
+        status = "409 Conflict";
