+            }
+            snprintf(s_reopen_url, sizeof s_reopen_url, "%s", url);
+            s_text_phase = 0;
+            open_dialog(s_reopen_url);
+        } else if (text_input_elapsed() >= 10000) {
+            tlog("Search keyboard: native cleanup unconfirmed status=%d; stopping", status);
+            text_input_phase(5);
+        }
+    }
+    return 1;
+}
